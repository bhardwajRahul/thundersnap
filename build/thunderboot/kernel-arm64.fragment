# ARM64 hardware and console requirements for Apple Virtualization.framework.
#
# The common appliance functionality comes from vm/kernel.config, which is
# also the x86-64 Cloud Hypervisor guest configuration. This fragment adds
# ARM64 boot/platform support and explicitly removes unrelated hardware and
# hypervisor families inherited from that cross-architecture base.
CONFIG_LOCALVERSION="-thunderboot"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=n
CONFIG_ARM64=y
CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_ARM64_4K_PAGES=y
# Keep the architecture defaults for VA/PA sizing; 52-bit VA/PA is valid on
# Apple silicon and the kernel automatically falls back when unavailable.
CONFIG_SMP=y

# VZLinuxBootLoader and Apple platform firmware/interrupt plumbing.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_ECAM=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PVPANIC=y
CONFIG_PVPANIC_MMIO=y
CONFIG_PVPANIC_PCI=y

# Apple VZ virtio devices: block, network, console, filesystem, and vsock.
# Keep both transports enabled: Apple has used virtio-mmio, while virtio-pci
# is cheap insurance against a VZ device-model change.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_FS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Apple documents hvc0 for VZ's virtio console. Keep a 16550/PL011 console
# too, since it is useful with alternate ARM64 firmware and diagnostics.
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_HVC_DRIVER=y

# VZLinuxBootLoader does not provide EFI, but Apple exposes an AMBA PL031
# compatible RTC to the Linux guest. Lima issue #2905 documents rtc_pl031 as
# the required driver. Keep the class, boot-time clock restore, and driver
# built in so the kernel can set time before userspace and TLS.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_DRV_PL031=y

# These features are inherited by the common x86 config but are not needed by
# the ARM64 VZ appliance. Keeping the negative declarations here prevents an
# architecture conversion from bringing in board, desktop, or nested-hypervisor
# support merely because it was enabled in vm/kernel.config.
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n
CONFIG_PTP_1588_CLOCK_KVM=n
CONFIG_XEN=n
CONFIG_HYPERV=n
CONFIG_VFIO=n
CONFIG_USB_SUPPORT=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_SCSI=n
CONFIG_ATA=n
CONFIG_MMC=n
CONFIG_I2C=n
CONFIG_SPI=n
CONFIG_CAN=n
CONFIG_FIREWIRE=n
CONFIG_INFINIBAND=n
CONFIG_WWAN=n
CONFIG_NFC=n
CONFIG_HID=n
CONFIG_MTD=n
CONFIG_WATCHDOG=n
CONFIG_HWMON=n
